                    "rightValue": "sistemas",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Canal Sistemas"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
